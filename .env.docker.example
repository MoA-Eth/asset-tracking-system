# Settings for running the Asset Tracking System with Docker.
# Copy this file to ".env" in the same folder and fill it in. Keep .env private; it is not committed.

# Deployment environment tier: dev (developer), qa (QA testing), stage (staging), prod (production)
APP_ENV=prod

# Password of the database inside Docker. Choose a long random value; letters and numbers only,
# because it becomes part of a web address.
POSTGRES_PASSWORD=

# Session signing key: a random value of at least 32 characters, unique to this installation.
# Generate one with:  docker run --rm node:22-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the app listens on the server.
#   127.0.0.1:3000   only the server itself (use with a reverse proxy that provides HTTPS; recommended)
#   0.0.0.0:3000     every network address of the server, port 3000 (no HTTPS)
APP_BIND=127.0.0.1:3000

# Set to 1 when the app runs behind one reverse proxy (nginx, IIS...), so sign-in limits see the real client address.
TRUST_PROXY=1

# The first System Administrator. Used the first time the app starts; ignored once an administrator exists.
# The password must be at least 12 characters with letters and numbers, and is replaced at the first sign-in.
# After the first sign-in you can remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_EMPLOYEE_ID=ADMIN-001
