// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SYSTEM_ADMIN
  DATA_ENCODER
  TEAM_LEADER
  DEPARTMENT_HEAD
  MANAGER
}

enum ItemStatus {
  PENDING_STOCK_IN
  AVAILABLE
  PENDING_STOCK_OUT
  ISSUED
  UNDER_TRANSFER
  // Disposal requested and waiting for approval; the units are still in store
  PENDING_DISPOSAL
  // Disposed of through an approved disposal request
  DISPOSED
  // Receipt (Stock-In) rejected by an approver
  REJECTED
}

enum AssetCategory {
  VEHICLE
  AGRI_MACHINERY
  IT_EQUIPMENT
  OFFICE_FURNITURE
  LAB_EQUIPMENT
  FIELD_GEAR
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  RETURN
  DISPOSAL
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  NEEDS_REPAIR
  DAMAGED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditEntityType {
  USER
  REFERENCE
  ITEM
  STOCK_IN
  STOCK_OUT
  TRANSFER
  RETURN
  APPROVAL
  DISPOSAL
}

// ─── Reference Tables ─────────────────────────────────────────────────────────

// ... (skip down to Item)


model Department {
  id             String  @id
  code           String  @unique
  nameEn         String
  nameAm         String
  headEmployeeId String?

  // Relations
  employees           Employee[]
  assignedItems       Item[]              @relation("AssignedDepartment")
  stockOutApprovals   TransactionApproval[] @relation("TargetDepartment")

  @@map("departments")
}

/// A store receives and issues stock. It contains one or more locations.
model Store {
  id       String  @id
  name     String  @unique
  /// Building or address, shown under the name
  address  String  @default("")
  /// Deactivated stores can't be picked on forms, but stay on past records
  isActive Boolean @default(true)

  // Relations
  locations Location[]

  @@map("stores")
}

/// A room, section or shelf inside a store, where items are kept.
model Location {
  id       String  @id
  storeId  String
  name     String
  /// Deactivated locations can't be picked on forms, but stay on past records
  isActive Boolean @default(true)

  // Relations
  store Store  @relation(fields: [storeId], references: [id])
  items Item[] @relation("StoreLocation")

  @@unique([storeId, name])
  @@map("locations")
}

model Employee {
  id          String   @id
  payrollId   String   @unique
  fullNameEn  String
  fullNameAm  String
  departmentId String
  jobTitle    String?
  /// Team inside the department (HR: የስራ ክፍል)
  unit        String?
  /// MALE or FEMALE (HR: ፆታ)
  gender      String?
  email       String?  @unique
  phone       String?
  /// System role; null means the employee can't sign in (custodians, recipients)
  role        UserRole?
  password    String? // scrypt hash; existing plaintext credentials are upgraded on login
  /// Set when an administrator gives a temporary password; cleared when the person chooses their own
  mustChangePassword Boolean @default(false)
  /// Deactivated employees can't sign in or be picked on forms, but stay in history
  isActive    Boolean  @default(true)

  // Relations
  department          Department            @relation(fields: [departmentId], references: [id])
  registeredItems     Item[]                @relation("RegisteredBy")
  approvedItems       Item[]                @relation("ApprovedBy")
  custodiedItems      Item[]                @relation("CurrentCustodian")
  requestedApprovals  TransactionApproval[] @relation("RequestedBy")
  endorsedApprovals   TransactionApproval[] @relation("EndorsedBy")
  reviewedApprovals   TransactionApproval[] @relation("ReviewedBy")
  recipientApprovals  TransactionApproval[] @relation("RecipientEmployee")
  auditLogs           AuditLog[]

  @@map("employees")
}

// ─── Core Asset Tables ────────────────────────────────────────────────────────

model Item {
  id           String        @id @default(uuid())
  itemCode     String        @unique
  name         String
  category     AssetCategory
  serialNumber String        @default("")
  unitCostETB  Float         @default(0)
  status       ItemStatus    @default(PENDING_STOCK_IN)
  condition    ItemCondition @default(NEW)

  // Storage & Assignment
  storeLocationId      String
  currentCustodianId   String?
  assignedDepartmentId String?
  // An issued record held by an outside organization instead of an employee (typed text; no employee custodian)
  heldByOrganization String?
  heldByContact      String?

  // IFMIS Reference
  ifmisSlipNumber        String
  ifmisSlipDateGc        String
  ifmisSlipDateEc        String
  ifmisSlipAttachmentUrl String?
  isHistoricalData       Boolean @default(false)
  notes                  String?

  // Set on records split off a batch by a partial Stock-Out; points at the original registration
  parentItemId String?

  // Metadata
  registeredById String
  approvedById   String?
  createdAtGc    String
  createdAtEc    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  storeLocation      Location    @relation("StoreLocation", fields: [storeLocationId], references: [id])
  currentCustodian   Employee?   @relation("CurrentCustodian", fields: [currentCustodianId], references: [id])
  assignedDepartment Department? @relation("AssignedDepartment", fields: [assignedDepartmentId], references: [id])
  registeredBy       Employee    @relation("RegisteredBy", fields: [registeredById], references: [id])
  approvedBy         Employee?   @relation("ApprovedBy", fields: [approvedById], references: [id])
  parentItem         Item?       @relation("ItemSplits", fields: [parentItemId], references: [id])
  splitItems         Item[]      @relation("ItemSplits")

  // Child tables
  history             ItemHistory[]
  approvals           TransactionApproval[]

  @@map("items")
}

model ItemHistory {
  id              String   @id @default(uuid())
  itemId          String
  dateGc          String
  dateEc          String
  action          String
  fromEntity      String?
  toEntity        String?
  performedBy     String
  performedByRole UserRole
  approvedBy      String?
  ifmisSlipNumber String?
  notes           String?
  createdAt       DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_history")
}

// ─── Approvals & Workflow ─────────────────────────────────────────────────────

model TransactionApproval {
  id              String          @id @default(uuid())
  transactionType TransactionType
  itemId          String
  itemCode        String
  itemName        String

  // IFMIS reference
  ifmisSlipNumber        String
  ifmisSlipDateGc        String
  ifmisSlipDateEc        String
  ifmisSlipAttachmentUrl String?

  // Parties
  requestedById      String
  recipientEmployeeId String?
  targetDepartmentId  String?
  targetLocationId    String?
  purposeOrRemarks    String  @default("")
  // Model 21 particulars of a transfer or return, kept as fields so the request can be corrected
  requestDetails      Json?

  // Status & Multi-Stage Workflow
  status             ApprovalStatus @default(PENDING)
  currentStage       Int            @default(1) // 1 = Team Leader Endorsement, 2 = Dept Head Approval

  // Stage 1: Team Leader Endorsement
  endorsedById       String?
  endorsementRemarks String?
  endorsedAtGc       String?
  endorsedAtEc       String?

  // Stage 2: Department Head Final Approval
  reviewedById  String?
  reviewRemarks String?
  createdAtGc   String
  createdAtEc   String
  reviewedAtGc  String?
  reviewedAtEc  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  item               Item        @relation(fields: [itemId], references: [id])
  requestedBy        Employee    @relation("RequestedBy", fields: [requestedById], references: [id])
  recipientEmployee  Employee?   @relation("RecipientEmployee", fields: [recipientEmployeeId], references: [id])
  targetDepartment   Department? @relation("TargetDepartment", fields: [targetDepartmentId], references: [id])
  endorsedBy         Employee?   @relation("EndorsedBy", fields: [endorsedById], references: [id])
  reviewedBy         Employee?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@map("transaction_approvals")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

/// Saved changes to a role's permissions. Roles without a row use the built-in defaults.
model RolePermissionSet {
  role        UserRole @id
  permissions String[]
  updatedById String
  updatedAt   DateTime @updatedAt

  @@map("role_permissions")
}

/// System-wide settings changed by the System Administrator; a missing row means the built-in default
model SystemSetting {
  key         String   @id
  value       String
  updatedById String
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id             String          @id @default(uuid())
  timestampGc    String
  timestampEc    String
  userId         String
  userName       String
  userRole       UserRole
  action         String
  entityType     AuditEntityType
  entityId       String
  ifmisSlipNumber String?
  details        String
  previousState  Json?
  newState       Json?
  createdAt      DateTime        @default(now())

  // Relations
  user     Employee @relation(fields: [userId], references: [id])
  // entityId targets either an asset or an employee, identified by entityType.

  @@index([entityType, entityId])
  @@map("audit_logs")
}
