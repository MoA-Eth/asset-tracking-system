# Backend Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moa_ams?schema=public"

# Session signing key. Required in production; use a unique random value (32+ characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without a configured key, development sessions expire when the server restarts.
JWT_SECRET=""

# Other websites allowed to call the API, comma-separated. Leave empty when the app is served by this server
# (the normal setup): the API then only answers the app's own pages.
CORS_ORIGIN=""

# Set to 1 when the app runs behind one reverse proxy (nginx, IIS...) that terminates HTTPS,
# so sign-in limits see the real client address.
TRUST_PROXY=""

# First-time setup of a real installation (npm run db:seed:production). Not read by the running app.
# ADMIN_EMAIL="admin@moa.gov.et"
# ADMIN_PASSWORD="at least 12 characters, with letters and numbers"
# ADMIN_NAME="System Administrator"
# ADMIN_EMPLOYEE_ID="ADMIN-001"
