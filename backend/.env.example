# Backend Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moa_ams?schema=public"

# Session signing key. Required in production; use a unique random value (32+ characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without a configured key, development sessions expire when the server restarts.
JWT_SECRET=""

# Other websites allowed to call the API, comma-separated. Leave empty when the app is served by this server
# (the normal setup): the API then only answers the app's own pages.
CORS_ORIGIN=""

# Set to 1 when the app runs behind one reverse proxy (nginx, IIS...) that terminates HTTPS,
# so sign-in limits see the real client address.
TRUST_PROXY=""

# First-time setup of a real installation (npm run db:seed:production). Not read by the running app.
# ADMIN_EMAIL="admin@moa.gov.et"
# ADMIN_PASSWORD="at least 12 characters, with letters and numbers"
# ADMIN_NAME="System Administrator"
# ADMIN_EMPLOYEE_ID="ADMIN-001"


# Frontend application URL for email invitation links
FRONTEND_URL="http://localhost:3000"
USER_INVITATION_HOURS=48

# Outbound Email Delivery (Gmail SMTP, Brevo API, or MailerSend)
# Configured once on the server, used to dispatch invitations and notifications to all users
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM='"Ministry of Agriculture ATS" <your-email@gmail.com>'

# Optional Brevo REST API configuration
# BREVO_API_KEY=""
# BREVO_FROM_EMAIL="notifications@moa.gov.et"
# BREVO_FROM_NAME="Ministry of Agriculture ATS"
