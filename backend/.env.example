# Backend Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moa_ams?schema=public"

# Session signing key. Required in production; use a unique random value (32+ characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without a configured key, development sessions expire when the server restarts.
JWT_SECRET=""
