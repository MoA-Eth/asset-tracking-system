# Settings for running the Asset Tracking System with Docker (docker-compose.yml).
# Copy this file to ".env" in the same folder and fill it in. Keep .env private; it is not committed.

# Deployment environment tier: dev (developer), qa (QA testing), stage (staging), prod (production)
APP_ENV=prod
TZ=Africa/Addis_Ababa

# Password of the database inside Docker. Choose a long random value; letters and numbers only,
# because it becomes part of a web address. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing key: a random value of at least 32 characters, unique to this installation.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# nginx (in docker-compose.yml) is the one reverse proxy in front of the API, so keep this at 1:
# sign-in limits then see the real client address.
TRUST_PROXY=1

# Other web addresses allowed to call the API from a browser, comma-separated. Usually empty.
CORS_ORIGIN=

# The first System Administrator. Used the first time the app starts; ignored once an administrator exists.
# The password must be at least 12 characters with letters and numbers, and is replaced at the first sign-in.
# After the first sign-in you can remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
# The administrator's 8-digit HR payroll ID, e.g. 00123456
ADMIN_EMPLOYEE_ID=
